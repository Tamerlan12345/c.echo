# Centras.Echo — Local Development Environment
# Copy this to .env.local for local development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/centras_echo
JWT_SECRET=dev-local-secret-minimum-32-characters-long

# Google OAuth — получить на console.cloud.google.com
# Для разработки добавьте: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# LiveKit Self-Hosted (локально через Docker)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-minimum-32-characters-long

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# App
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PORT=3001
LOG_LEVEL=debug
NODE_ENV=development
AUDIO_STORAGE_PATH=./tmp/audio
